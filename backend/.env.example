# How long a single run is allowed to run before it gets force-killed.
MAX_RUNTIME_SECONDS=20

# How many containers can be running across all connections at once.
MAX_CONCURRENT_RUNS=10

# AI models apis
GROQ_API_KEY=your-api-key

GOOGLE_API_KEY=your-api-key


# DB Persistence Path (will create automatically)
DB_PATH="chat_state.db"

# Safety and Token Guardrails
MAX_MESSAGE_CHARS=8000
RECENT_MESSAGES_TO_KEEP=6
SUMMARIZE_THRESHOLD=12